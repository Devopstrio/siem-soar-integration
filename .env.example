# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="SIEM + SOAR Integration Platform"

# Security
SECRET_KEY=siemsoarintegrationsecretkey12345
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
